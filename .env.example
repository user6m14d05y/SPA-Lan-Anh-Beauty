# ==============================================================================
# Environment Configuration Template for SPA Lan Anh Beauty
# Sao chép file này thành .env trên môi trường sản xuất VPS:
# cp .env.example .env
# ==============================================================================

# === DOMAIN & URL CONFIG ===
# Domain chính sản xuất (Không chạy subdomain riêng cho backend, chạy chung 1 domain)
DOMAIN_NAME=lananhbeauty.thanhbtdev.id.vn
CLIENT_URL=https://lananhbeauty.thanhbtdev.id.vn
CORS_ORIGINS=https://lananhbeauty.thanhbtdev.id.vn

# API Endpoint & WebSocket URL (Nginx sẽ proxy /api tự động)
VITE_API_URL=/api
VITE_SOCKET_URL=

# TinyMCE API Key (Editor)
VITE_TINY_MCE_API_KEY=your_tinymce_api_key

# === SERVER & REDIS ===
PORT=5000
REDIS_HOST=redis
REDIS_PORT=6379

# === DATABASE (MYSQL) ===
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
DB_HOST=mysql
DB_PORT=3306
DB_NAME=spa_lananh
DB_USER=spa_user
DB_PASS=your_db_password_here

# === JWT & CAPTCHA SECURITY ===
JWT_SECRET=replace_with_a_random_32_character_jwt_secret
CAPTCHA_SECRET=replace_with_a_random_32_character_captcha_secret

# === SMTP EMAIL NOTIFICATION ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Lan Anh Beauty <no-reply@lananhbeauty.thanhbtdev.id.vn>"

# === GEMINI AI CHATBOT ===
GEMINI_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# === SEPAY PAYMENT GATEWAY ===
SEPAY_API_KEY=replace_with_your_sepay_api_key
SEPAY_SECRET_KEY=replace_with_a_random_32_character_sepay_secret